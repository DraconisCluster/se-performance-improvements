<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <!--
    SE-DX2.0Code build of the Torch plugin (the only PerformanceImprovements project in Expanse2.sln).
    References come from the NuGet reference packages the other plugins use instead of a local Torch junction,
    so CI can build it. The Zip target writes plugins\.build\PerformanceImprovements.zip, which the
    "Build solution" workflow pushes to Harbor as se-dx2/performanceimprovements (version from ..\manifest.xml).
  -->
  <PropertyGroup>
    <TargetFramework>net481</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>TorchPlugin</RootNamespace>
    <AssemblyName>PerformanceImprovements</AssemblyName>
    <LangVersion>13</LangVersion>
    <UseWPF>true</UseWPF>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <!-- Keep in step with <Version> in ..\manifest.xml. -->
    <AssemblyVersion>1.11.22.1</AssemblyVersion>
    <FileVersion>1.11.22.1</FileVersion>
    <RestoreAdditionalProjectSources>https://nuget.storage.yandexcloud.net/index.json</RestoreAdditionalProjectSources>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <PlatformTarget>x64</PlatformTarget>
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin\Debug\</OutputPath>
    <DefineConstants>TORCH;TRACE;DEV_BUILD</DefineConstants>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <PlatformTarget>x64</PlatformTarget>
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
    <DefineConstants>TORCH;TRACE;DEV_BUILD</DefineConstants>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="mscorlib" />
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Xaml" />
    <Reference Include="System.Xml" />
    <Reference Include="WindowsBase" />
  </ItemGroup>

  <ItemGroup>
    <!-- Compile-only: Torch and the game are on the server. Exact versions so CI builds are repeatable. -->
    <PackageReference Include="Torch.Server.ReferenceAssemblies" Version="1.3.1.325-master" ExcludeAssets="runtime" />
    <!-- Torch pins 1.207.22 transitively; override it to match the game version the servers run. -->
    <PackageReference Include="SpaceEngineersDedicated.ReferenceAssemblies" Version="1.211.19" ExcludeAssets="runtime" />
    <!-- SyntaxTree in PerfCountingRewriterPatch; the game ships Microsoft.CodeAnalysis 2.9.0.0. -->
    <PackageReference Include="Microsoft.CodeAnalysis.Common" Version="2.9.0" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <!-- Shipped in the zip, as before: the plugin loads its own Harmony and Unsafe. -->
    <PackageReference Include="Lib.Harmony" Version="2.4.2" />
    <PackageReference Include="System.Runtime.CompilerServices.Unsafe" Version="6.1.2" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\manifest.xml" Link="manifest.xml">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <None Include="App.config" />
  </ItemGroup>

  <!--
    Zip only the files the plugin ships (the same set as the hand-built Performance Improvements.zip, plus the pdb
    for stack traces). The output folder also holds transitive packages (NLog, Roslyn's dependencies) that the server
    already has; shipping them could shadow the server's copies.
  -->
  <Target Name="Zip" AfterTargets="Build" Condition="'$(SolutionDir)' != '' And '$(SolutionDir)' != '*Undefined*'">
    <PropertyGroup>
      <PluginZipStage>$(BaseIntermediateOutputPath)zip\</PluginZipStage>
    </PropertyGroup>
    <ItemGroup>
      <PluginZipFile Include="$(OutDir)PerformanceImprovements.dll;$(OutDir)PerformanceImprovements.pdb;$(OutDir)0Harmony.dll;$(OutDir)System.Runtime.CompilerServices.Unsafe.dll;$(OutDir)manifest.xml" />
    </ItemGroup>
    <Error Condition="!Exists('%(PluginZipFile.Identity)')" Text="PerformanceImprovements zip: missing %(PluginZipFile.Identity)" />
    <RemoveDir Directories="$(PluginZipStage)" />
    <Copy SourceFiles="@(PluginZipFile)" DestinationFolder="$(PluginZipStage)" />
    <MakeDir Directories="$(SolutionDir)plugins\.build" />
    <ZipDirectory SourceDirectory="$(PluginZipStage)" DestinationFile="$(SolutionDir)plugins\.build\PerformanceImprovements.zip" Overwrite="true" />
  </Target>

  <Import Project="..\Shared\Shared.projitems" Label="Shared" />
</Project>
